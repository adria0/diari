import { Button, LineEdit, TextEdit, ListView, ScrollView, Palette, Switch } from "std-widgets.slint";

export struct NoteItem {
    path: string,
    title: string,
    subtitle: string,
}

// kind: 0 context, 1 added, 2 removed, 3 gap between hunks
export struct DiffRow {
    kind: int,
    text: string,
}

export struct VersionItem {
    id: string,
    title: string,
    subtitle: string,
}

// Font of the editor and other note text, set from Settings.
export global EditorFont {
    in-out property <string> family: "monospace";
    in-out property <length> size: 14px;
}

// kind: 0 paragraph, 1-6 heading, 7 code, 8 quote, 9 list item, 10 rule,
// 11 image (shown), 12 link (tap to open)
export struct MdBlock {
    kind: int,
    text: string,
    indent: int,
    image: image,
    target: string,
}

// state: 0 ok, 1 syncing, 2 error, 3 conflicts, 4 local only
component StatusChip inherits Rectangle {
    in property <int> state;
    in property <string> text;
    callback clicked();
    property <color> dot: state == 2 ? #d64545 : state == 3 ? #e8912d : state == 1 ? #3b82f6 : state == 4 ? #9ca3af : #22a55b;

    height: 30px;
    border-radius: 15px;
    background: ta.has-hover ? dot.with-alpha(0.28) : dot.with-alpha(0.16);
    ta := TouchArea {
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 12px;
        spacing: 6px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: root.dot;
            }
        }
        Text {
            text: root.text;
            vertical-alignment: center;
            font-size: 12px;
            color: Palette.foreground;
            overflow: elide;
        }
    }
}

component ListPane inherits Rectangle {
    in property <[NoteItem]> notes;
    in property <string> current;
    in property <string> status-text;
    in property <int> status-state;
    in-out property <string> filter;
    in property <string> default-new-name;
    in-out property <string> quick-text;
    // The quick-add bar is only shown when the app was opened to add a line
    // (Android share or the "Quick add" shortcut).
    in-out property <bool> quick-visible;
    callback quick-add(string);
    callback open(string);
    callback create(string);
    callback today();
    callback sync-now();
    callback settings();
    callback filter-edited(string);

    function do-create() {
        if new-name.text != "" {
            root.create(new-name.text);
            new-name.text = root.default-new-name;
        }
    }

    function do-quick-add() {
        if root.quick-text != "" {
            root.quick-add(root.quick-text);
        }
    }

    changed default-new-name => {
        if !new-name.has-focus {
            new-name.text = root.default-new-name;
        }
    }

    background: Palette.alternate-background;
    VerticalLayout {
        padding: 12px;
        spacing: 8px;
        HorizontalLayout {
            spacing: 8px;
            Text {
                text: "Notes";
                font-size: 22px;
                font-weight: 700;
                vertical-alignment: center;
                color: Palette.foreground;
                horizontal-stretch: 1;
            }
            VerticalLayout {
                alignment: center;
                StatusChip {
                    state: root.status-state;
                    text: root.status-text;
                    clicked => { root.sync-now(); }
                }
            }
            Button {
                text: "Today";
                primary: true;
                clicked => { root.today(); }
            }
            Button {
                icon: @image-url("../icons/gear-64.png");
                colorize-icon: true;
                accessible-label: "Settings";
                clicked => { root.settings(); }
            }
        }
        if root.quick-visible: HorizontalLayout {
            spacing: 8px;
            LineEdit {
                placeholder-text: "Add a line to today…";
                text <=> root.quick-text;
                accepted => { root.do-quick-add(); }
                init => { self.focus(); }
            }
            Button {
                text: "Add";
                primary: true;
                enabled: root.quick-text != "";
                clicked => { root.do-quick-add(); }
            }
            Button {
                text: "Cancel";
                clicked => {
                    root.quick-text = "";
                    root.quick-visible = false;
                }
            }
        }
        LineEdit {
            placeholder-text: "Search names and text";
            text <=> root.filter;
            edited(t) => { root.filter-edited(t); }
        }
        HorizontalLayout {
            spacing: 8px;
            new-name := LineEdit {
                placeholder-text: "New note name";
                text: root.default-new-name;
                accepted => { root.do-create(); }
            }
            Button {
                text: "Create";
                primary: true;
                enabled: new-name.text != "";
                clicked => { root.do-create(); }
            }
        }
        ListView {
            vertical-stretch: 1;
            for n in root.notes: Rectangle {
                height: 54px;
                border-radius: 6px;
                background: n.path == root.current ? Palette.selection-background.with-alpha(0.35)
                    : ta.has-hover ? Palette.foreground.with-alpha(0.06) : transparent;
                ta := TouchArea {
                    clicked => { root.open(n.path); }
                }
                VerticalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    alignment: center;
                    spacing: 2px;
                    Text {
                        text: n.title;
                        font-size: 15px;
                        color: Palette.foreground;
                        overflow: elide;
                    }
                    Text {
                        text: n.subtitle;
                        font-size: 11px;
                        color: Palette.foreground.with-alpha(0.55);
                        overflow: elide;
                    }
                }
            }
        }
    }
}

component PreviewView inherits Rectangle {
    in property <[MdBlock]> blocks;
    callback open-link(string);
    ListView {
        for b in root.blocks: HorizontalLayout {
            padding-left: 12px + b.indent * 20px;
            padding-right: 12px;
            padding-top: b.kind >= 1 && b.kind <= 6 ? 12px : 4px;
            padding-bottom: 4px;
            spacing: 10px;
            if b.kind == 8: Rectangle {
                width: 3px;
                background: Palette.accent-background;
            }
            if b.kind == 10: VerticalLayout {
                alignment: center;
                padding-top: 6px;
                padding-bottom: 6px;
                Rectangle {
                    height: 1px;
                    background: Palette.foreground.with-alpha(0.25);
                }
            }
            if b.kind == 11: Rectangle {
                height: min(420px, (root.width - 24px - b.indent * 20px) * b.image.height / max(1, b.image.width));
                Image {
                    width: parent.width;
                    height: parent.height;
                    source: b.image;
                    image-fit: contain;
                    horizontal-alignment: left;
                }
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.open-link(b.target); }
                }
            }
            if b.kind == 12: Rectangle {
                height: link-text.preferred-height + 8px;
                border-radius: 4px;
                background: link-ta.has-hover ? Palette.accent-background.with-alpha(0.12) : transparent;
                link-text := Text {
                    x: 4px;
                    width: parent.width - 8px;
                    text: "→ " + b.text;
                    wrap: word-wrap;
                    color: Palette.accent-background;
                    font-size: 15px;
                }
                link-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.open-link(b.target); }
                }
            }
            if b.kind != 10 && b.kind < 11: Rectangle {
                background: b.kind == 7 ? Palette.alternate-background : transparent;
                border-radius: 4px;
                HorizontalLayout {
                    padding: b.kind == 7 ? 8px : 0px;
                    Text {
                        text: b.text;
                        wrap: word-wrap;
                        color: b.kind == 8 ? Palette.foreground.with-alpha(0.75) : Palette.foreground;
                        font-size: b.kind == 1 ? 28px : b.kind == 2 ? 23px : b.kind == 3 ? 19px : b.kind >= 4 && b.kind <= 6 ? 16px : b.kind == 7 ? 13px : 15px;
                        font-weight: b.kind >= 1 && b.kind <= 6 ? 700 : 400;
                        font-family: b.kind == 7 ? "monospace" : "";
                        font-italic: b.kind == 8;
                    }
                }
            }
        }
    }
}

component VersionList inherits ListView {
    in property <[VersionItem]> versions;
    in property <string> selected;
    callback select(string);

    for v in root.versions: Rectangle {
        height: 50px;
        border-radius: 6px;
        background: v.id == root.selected ? Palette.selection-background.with-alpha(0.35)
            : vta.has-hover ? Palette.foreground.with-alpha(0.06) : transparent;
        vta := TouchArea {
            clicked => { root.select(v.id); }
        }
        VerticalLayout {
            padding-left: 10px;
            padding-right: 10px;
            alignment: center;
            Text {
                text: v.title;
                font-size: 13px;
                font-weight: 600;
                color: Palette.foreground;
                overflow: elide;
            }
            Text {
                text: v.subtitle;
                font-size: 11px;
                color: Palette.foreground.with-alpha(0.6);
                overflow: elide;
            }
        }
    }
}

component DiffView inherits Rectangle {
    in property <[DiffRow]> rows;
    background: Palette.background;
    border-radius: 4px;
    border-width: 1px;
    border-color: Palette.foreground.with-alpha(0.12);
    if root.rows.length == 0: Text {
        text: "No changes to this note in this version";
        color: Palette.foreground.with-alpha(0.5);
    }
    ListView {
        for r in root.rows: Rectangle {
            background: r.kind == 1 ? #22a55b30 : r.kind == 2 ? #d6454530 : transparent;
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                padding-top: r.kind == 3 ? 4px : 1px;
                padding-bottom: r.kind == 3 ? 4px : 1px;
                spacing: 8px;
                Text {
                    width: 12px;
                    text: r.kind == 1 ? "+" : r.kind == 2 ? "−" : r.kind == 3 ? "⋯" : "";
                    color: r.kind == 1 ? #22a55b : r.kind == 2 ? #d64545 : Palette.foreground.with-alpha(0.4);
                    font-family: EditorFont.family;
                    font-size: EditorFont.size;
                }
                Text {
                    horizontal-stretch: 1;
                    text: r.text;
                    wrap: word-wrap;
                    color: r.kind == 0 ? Palette.foreground.with-alpha(0.6) : Palette.foreground;
                    font-family: EditorFont.family;
                    font-size: EditorFont.size;
                }
            }
        }
    }
}

component VersionText inherits TextEdit {
    read-only: true;
    wrap: word-wrap;
    font-family: EditorFont.family;
    font-size: EditorFont.size;
}

component HistoryPane inherits VerticalLayout {
    in property <[VersionItem]> versions;
    in property <string> selected;
    in property <string> text;
    in property <[DiffRow]> diff;
    in-out property <bool> show-changes: true;
    callback select(string);
    callback restore();
    callback close();

    in property <bool> side-by-side;

    spacing: 8px;
    HorizontalLayout {
        spacing: 8px;
        Text {
            text: "History (\{root.versions.length})";
            font-size: 14px;
            font-weight: 600;
            vertical-alignment: center;
            color: Palette.foreground;
            horizontal-stretch: 1;
        }
        Button {
            text: root.show-changes ? "Full text" : "Changes";
            clicked => { root.show-changes = !root.show-changes; }
        }
        Button {
            text: "Restore";
            primary: true;
            enabled: root.selected != "";
            clicked => { root.restore(); }
        }
        Button {
            text: "Close";
            clicked => { root.close(); }
        }
    }
    if root.side-by-side: HorizontalLayout {
        vertical-stretch: 1;
        spacing: 8px;
        VersionList {
            width: 260px;
            versions: root.versions;
            selected: root.selected;
            select(id) => { root.select(id); }
        }
        if !root.show-changes: VersionText {
            horizontal-stretch: 1;
            text: root.text;
        }
        if root.show-changes: DiffView {
            horizontal-stretch: 1;
            rows: root.diff;
        }
    }
    if !root.side-by-side: VerticalLayout {
        vertical-stretch: 1;
        spacing: 8px;
        VersionList {
            height: 180px;
            versions: root.versions;
            selected: root.selected;
            select(id) => { root.select(id); }
        }
        if !root.show-changes: VersionText {
            vertical-stretch: 1;
            text: root.text;
        }
        if root.show-changes: DiffView {
            vertical-stretch: 1;
            rows: root.diff;
        }
    }
}

component EditorPane inherits Rectangle {
    in property <string> path;
    in property <bool> dirty;
    in property <bool> show-back;
    in property <[MdBlock]> blocks;
    in-out property <bool> preview;
    in-out property <string> text;
    in property <bool> show-history;
    in property <[VersionItem]> versions;
    in property <string> history-selected;
    in property <string> history-text;
    in property <[DiffRow]> history-diff;
    in property <bool> history-side-by-side;
    callback edited(string);
    callback toggle-preview();
    callback open-link(string);
    callback open-history();
    callback select-version(string);
    callback restore-version();
    callback close-history();
    callback back();
    callback delete();
    callback rename(string);
    // The Delete button is off unless enabled in Settings.
    in property <bool> show-delete;
    property <bool> confirm-delete: false;
    property <bool> renaming: false;

    changed path => {
        root.confirm-delete = false;
        root.renaming = false;
    }

    background: Palette.background;
    VerticalLayout {
        padding: 12px;
        spacing: 8px;
        HorizontalLayout {
            spacing: 8px;
            if root.show-back: Button {
                text: "‹";
                clicked => { root.back(); }
            }
            // The note's name; the pencil turns it into a field to rename it.
            if !root.renaming: Text {
                text: root.path;
                horizontal-stretch: 1;
                min-width: 40px;
                vertical-alignment: center;
                overflow: elide;
                font-size: 15px;
                font-weight: 600;
                color: Palette.foreground;
            }
            if !root.renaming: Button {
                icon: @image-url("../icons/pencil-64.png");
                colorize-icon: true;
                icon-size: 16px;
                accessible-label: "Rename";
                enabled: !root.show-history;
                clicked => { root.renaming = true; }
            }
            if root.renaming: LineEdit {
                text: root.path;
                horizontal-stretch: 1;
                min-width: 40px;
                init => {
                    self.focus();
                    self.select-all();
                }
                accepted(t) => {
                    root.renaming = false;
                    if t != root.path {
                        root.rename(t);
                    }
                }
            }
            if root.renaming: Button {
                text: "Cancel";
                clicked => { root.renaming = false; }
            }
            VerticalLayout {
                alignment: center;
                Text {
                    text: root.dirty ? "●" : " ";
                    color: Palette.accent-background;
                    width: 12px;
                }
            }
            Button {
                text: root.preview ? "Edit" : "Preview";
                enabled: !root.show-history;
                clicked => { root.toggle-preview(); }
            }
            Button {
                text: "History";
                enabled: !root.show-history;
                clicked => { root.open-history(); }
            }
            if root.show-delete && !root.renaming: Button {
                text: root.confirm-delete ? "Really?" : "Delete";
                clicked => {
                    if root.confirm-delete {
                        root.confirm-delete = false;
                        root.delete();
                    } else {
                        root.confirm-delete = true;
                    }
                }
            }
        }
        if root.show-history: HistoryPane {
            vertical-stretch: 1;
            versions: root.versions;
            selected: root.history-selected;
            text: root.history-text;
            diff: root.history-diff;
            side-by-side: root.history-side-by-side;
            select(id) => { root.select-version(id); }
            restore => { root.restore-version(); }
            close => { root.close-history(); }
        }
        if !root.show-history && !root.preview: TextEdit {
            vertical-stretch: 1;
            text <=> root.text;
            wrap: word-wrap;
            font-family: EditorFont.family;
            font-size: EditorFont.size;
            edited(t) => { root.edited(t); }
        }
        if !root.show-history && root.preview: PreviewView {
            vertical-stretch: 1;
            blocks: root.blocks;
            open-link(t) => { root.open-link(t); }
        }
    }
}

component Field inherits VerticalLayout {
    in property <string> label;
    in property <string> placeholder;
    in-out property <string> value;
    spacing: 4px;
    Text {
        text: root.label;
        font-size: 12px;
        color: Palette.foreground.with-alpha(0.7);
    }
    LineEdit {
        text <=> root.value;
        placeholder-text: root.placeholder;
    }
}

component SettingsPane inherits Rectangle {
    in-out property <string> remote;
    in-out property <string> branch;
    in-out property <string> author-name;
    in-out property <string> author-email;
    in-out property <string> device;
    in-out property <string> notes-dir;
    in-out property <string> editor-font;
    in-out property <string> editor-font-size;
    in property <string> default-font;
    in-out property <bool> show-delete;
    in property <bool> show-notes-dir;
    in property <string> public-key;
    in property <string> key-fingerprint;
    callback save();
    callback close();
    callback regenerate-key();
    property <bool> copied: false;

    background: Palette.background;
    ScrollView {
        VerticalLayout {
            padding: 16px;
            spacing: 12px;
            alignment: start;
            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: "Settings";
                    font-size: 22px;
                    font-weight: 700;
                    color: Palette.foreground;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                }
                Button {
                    text: "Cancel";
                    clicked => { root.close(); }
                }
                Button {
                    text: "Save & sync";
                    primary: true;
                    clicked => { root.save(); }
                }
            }
            Field {
                label: "Git remote (SSH)";
                placeholder: "git@github.com:you/notes.git";
                value <=> root.remote;
            }
            Field {
                label: "Branch";
                placeholder: "main";
                value <=> root.branch;
            }
            Field {
                label: "Author name";
                value <=> root.author-name;
            }
            Field {
                label: "Author email";
                value <=> root.author-email;
            }
            Field {
                label: "Device name (used in commits and conflict files)";
                value <=> root.device;
            }
            if root.show-notes-dir: Field {
                label: "Notes folder (applies after restart)";
                value <=> root.notes-dir;
            }
            HorizontalLayout {
                spacing: 8px;
                Field {
                    horizontal-stretch: 3;
                    label: "Editor font (empty: \{root.default-font})";
                    placeholder: root.default-font;
                    value <=> root.editor-font;
                }
                Field {
                    horizontal-stretch: 1;
                    label: "Size";
                    placeholder: "14";
                    value <=> root.editor-font-size;
                }
            }
            Switch {
                text: "Show a Delete button on notes";
                checked <=> root.show-delete;
            }
            Text {
                text: "SSH public key: add it to your git host as a deploy key with write access";
                font-size: 12px;
                wrap: word-wrap;
                color: Palette.foreground.with-alpha(0.7);
            }
            key-view := TextEdit {
                text: root.public-key;
                read-only: true;
                wrap: word-wrap;
                font-family: EditorFont.family;
                font-size: 12px;
                height: 90px;
            }
            Text {
                text: root.key-fingerprint;
                font-size: 11px;
                font-family: EditorFont.family;
                color: Palette.foreground.with-alpha(0.6);
                wrap: word-wrap;
            }
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                Button {
                    text: root.copied ? "Copied" : "Copy key";
                    clicked => {
                        key-view.select-all();
                        key-view.copy();
                        key-view.clear-selection();
                        root.copied = true;
                    }
                }
                Button {
                    text: "Generate new key";
                    clicked => {
                        root.copied = false;
                        root.regenerate-key();
                    }
                }
            }
        }
    }
}

export component AppWindow inherits Window {
    icon: @image-url("../icons/diari-256.png");
    title: "diari";
    preferred-width: 1000px;
    preferred-height: 700px;
    min-width: 320px;
    min-height: 420px;
    background: Palette.background;

    in property <[NoteItem]> notes;
    in-out property <string> filter;
    in property <string> default-new-name;
    in-out property <string> current-path;
    in-out property <string> editor-text;
    in-out property <bool> dirty;
    in-out property <bool> preview;
    in property <[MdBlock]> blocks;
    in-out property <bool> show-history;
    in property <[VersionItem]> versions;
    in property <string> history-selected;
    in property <string> history-text;
    in property <[DiffRow]> history-diff;
    in-out property <string> quick-text;
    in-out property <bool> quick-visible;
    callback quick-add(string);
    in property <string> sync-text: "Starting…";
    in property <int> sync-state: 1;
    in property <string> message;
    in property <bool> desktop;
    in-out property <bool> show-settings;

    in-out property <string> cfg-remote;
    in-out property <string> cfg-branch;
    in-out property <string> cfg-author-name;
    in-out property <string> cfg-author-email;
    in-out property <string> cfg-device;
    in-out property <string> cfg-notes-dir;
    in-out property <string> cfg-editor-font;
    in-out property <string> cfg-editor-font-size;
    in property <string> default-font;
    in-out property <bool> cfg-show-delete;
    in property <bool> show-delete;
    in property <string> public-key;
    in property <string> key-fingerprint;

    callback open-note(string);
    callback new-note(string);
    callback open-today();
    callback rename-note(string);
    callback delete-note();
    callback text-edited(string);
    callback preview-toggled();
    callback open-link(string);
    callback open-history();
    callback select-version(string);
    callback restore-version();
    callback close-history();
    callback sync-now();
    callback open-settings();
    callback save-settings();
    callback regenerate-key();
    callback filter-edited(string);
    callback back();

    property <bool> wide: root.width >= 720px;

    VerticalLayout {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        if root.show-settings: SettingsPane {
            vertical-stretch: 1;
            remote <=> root.cfg-remote;
            branch <=> root.cfg-branch;
            author-name <=> root.cfg-author-name;
            author-email <=> root.cfg-author-email;
            device <=> root.cfg-device;
            notes-dir <=> root.cfg-notes-dir;
            editor-font <=> root.cfg-editor-font;
            editor-font-size <=> root.cfg-editor-font-size;
            default-font: root.default-font;
            show-delete <=> root.cfg-show-delete;
            show-notes-dir: root.desktop;
            public-key: root.public-key;
            key-fingerprint: root.key-fingerprint;
            save => { root.save-settings(); }
            close => { root.show-settings = false; }
            regenerate-key => { root.regenerate-key(); }
        }

        if !root.show-settings: HorizontalLayout {
            vertical-stretch: 1;
            if root.wide || root.current-path == "": ListPane {
                width: root.wide ? 300px : root.width;
                notes: root.notes;
                current: root.current-path;
                status-text: root.sync-text;
                status-state: root.sync-state;
                filter <=> root.filter;
                default-new-name: root.default-new-name;
                quick-text <=> root.quick-text;
                quick-visible <=> root.quick-visible;
                quick-add(t) => { root.quick-add(t); }
                open(p) => { root.open-note(p); }
                create(n) => { root.new-note(n); }
                today => { root.open-today(); }
                sync-now => { root.sync-now(); }
                settings => { root.open-settings(); }
                filter-edited(t) => { root.filter-edited(t); }
            }
            if root.wide: Rectangle {
                width: 1px;
                background: Palette.foreground.with-alpha(0.12);
            }
            if root.current-path != "": EditorPane {
                horizontal-stretch: 1;
                path: root.current-path;
                dirty: root.dirty;
                show-back: !root.wide;
                blocks: root.blocks;
                preview <=> root.preview;
                text <=> root.editor-text;
                edited(t) => { root.text-edited(t); }
                toggle-preview => { root.preview-toggled(); }
                open-link(t) => { root.open-link(t); }
                show-history: root.show-history;
                versions: root.versions;
                history-selected: root.history-selected;
                history-text: root.history-text;
                history-diff: root.history-diff;
                show-delete: root.show-delete;
                history-side-by-side: root.width >= 1000px;
                open-history => { root.open-history(); }
                select-version(id) => { root.select-version(id); }
                restore-version => { root.restore-version(); }
                close-history => { root.close-history(); }
                back => { root.back(); }
                delete => { root.delete-note(); }
                rename(n) => { root.rename-note(n); }
            }
            if root.wide && root.current-path == "": Rectangle {
                horizontal-stretch: 1;
                Text {
                    text: "Select or create a note";
                    color: Palette.foreground.with-alpha(0.5);
                    font-size: 16px;
                }
            }
        }

        if root.message != "": Rectangle {
            background: #d6454530;
            HorizontalLayout {
                padding: 8px;
                Text {
                    text: root.message;
                    wrap: word-wrap;
                    color: Palette.foreground;
                    font-size: 12px;
                }
            }
        }
    }
}
