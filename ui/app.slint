import { Button, CheckBox, ComboBox, LineEdit, TextEdit, ListView, ScrollView, Palette, Switch } from "std-widgets.slint";

export struct NoteItem {
    path: string,
    title: string,
    subtitle: string,
}

export struct WorkspaceItem {
    folder: string,
    name: string,
    color: color,
}

// kind: 0 context, 1 added, 2 removed, 3 gap between hunks
export struct DiffRow {
    kind: int,
    text: string,
}

// A file attached to the open note.
export struct FileItem {
    name: string,
    size: string,
    // Thumbnail, for images; otherwise `ext` (e.g. "PDF") is shown.
    image: image,
    is-image: bool,
    ext: string,
}

export struct VersionItem {
    id: string,
    title: string,
    subtitle: string,
}

// Font of the editor and other note text, set from Settings.
export global EditorFont {
    in-out property <string> family: "monospace";
    in-out property <length> size: 14px;
}

// kind: 0 paragraph, 1-6 heading, 7 code, 8 quote, 9 list item, 10 rule,
// 11 image (shown), 12 link (tap to open)
export struct MdBlock {
    kind: int,
    text: string,
    indent: int,
    image: image,
    target: string,
    // Task items (kind 13): ticked, and where their box is in the text.
    checked: bool,
    pos: int,
}

// state: 0 ok, 1 syncing, 2 error, 3 conflicts, 4 local only
// The sync button: arrows that are green when synced, red on errors or
// conflicts, orange and spinning while syncing, grey with no remote.
// Tap to sync now. `text` ("Synced 12:30", …) is for screen readers.
// state: 0 ok, 1 syncing, 2 error, 3 conflicts, 4 local only
component StatusChip inherits Rectangle {
    in property <int> state;
    in property <string> text;
    callback clicked();
    property <color> tint: state == 1 ? #e8912d : state == 2 || state == 3 ? #d64545 : state == 4 ? #9ca3af : #22a55b;

    width: 44px;
    min-height: 32px;
    border-radius: 6px;
    background: ta.pressed ? tint.with-alpha(0.25) : ta.has-hover ? tint.with-alpha(0.15) : transparent;
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { root.clicked(); }
    Image {
        source: @image-url("../icons/sync-64.png");
        colorize: root.tint;
        width: 22px;
        height: 22px;
        // One turn a second while syncing.
        transform-rotation: root.state == 1 ? Math.mod(animation-tick() / 1ms, 1000) * 0.36deg : 0deg;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// The voice note button: a red button with a white microphone.
component RecordButton inherits Rectangle {
    callback clicked();
    width: 44px;
    min-height: 32px;
    border-radius: 6px;
    background: ta.pressed ? #b03030 : ta.has-hover ? #e05050 : #d64545;
    accessible-role: button;
    accessible-label: "Voice note";
    accessible-action-default => { root.clicked(); }
    Image {
        source: @image-url("../icons/mic-64.png");
        colorize: white;
        width: 18px;
        height: 18px;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// A row of the workspace menu: colour dot, name, and a tick when active.
component WorkspaceRow inherits Rectangle {
    in property <string> label;
    in property <color> dot;
    in property <bool> selected;
    callback clicked();
    height: 40px;
    border-radius: 4px;
    background: ta.has-hover ? Palette.foreground.with-alpha(0.06) : transparent;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 10px;
                height: 10px;
                border-radius: 5px;
                background: root.dot;
            }
        }
        Text {
            text: root.label;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
            color: Palette.foreground;
            font-size: 15px;
            font-weight: root.selected ? 700 : 400;
        }
        if root.selected: VerticalLayout {
            alignment: center;
            Path {
                width: 12px;
                height: 10px;
                commands: "M 1 5 L 4.5 8.5 L 11 1.5";
                stroke: Palette.accent-background;
                stroke-width: 2px;
                fill: transparent;
            }
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component ListPane inherits Rectangle {
    in property <[NoteItem]> notes;
    in property <string> current;
    in property <string> status-text;
    in property <int> status-state;
    in-out property <string> filter;
    in property <string> default-new-name;
    in-out property <string> quick-text;
    // The quick-add bar is only shown when the app was opened to add a line
    // (Android share or the "Quick add" shortcut).
    in-out property <bool> quick-visible;
    callback quick-add(string);
    callback open(string);
    callback create(string);
    callback today();
    callback voice();
    callback photo();
    // Android: a camera button to add a picture to today's note.
    in property <bool> can-photo;
    callback sync-now();
    callback settings();
    callback filter-edited(string);
    // Workspaces (top-level folders with their own CONFIG.md). The header
    // shows the active one ("" for all of them) and switches between them.
    in property <bool> has-workspaces;
    in property <[WorkspaceItem]> workspaces;
    in property <string> active-workspace;
    in property <string> active-name;
    in property <color> active-color;
    callback select-workspace(string);
    callback new-workspace(string);
    // The notes are still at the top, from before workspaces: offer to
    // move them into diari/.
    in property <bool> needs-migration;
    callback migrate();
    callback migrate-later();
    property <bool> creating-workspace;

    function do-create() {
        if new-name.text != "" {
            root.create(new-name.text);
            new-name.text = root.default-new-name;
        }
    }

    function do-quick-add() {
        if root.quick-text != "" {
            root.quick-add(root.quick-text);
        }
    }

    changed default-new-name => {
        if !new-name.has-focus {
            new-name.text = root.default-new-name;
        }
    }

    background: Palette.alternate-background;
    VerticalLayout {
        padding: 12px;
        spacing: 8px;
        header := HorizontalLayout {
            spacing: 8px;
            if !root.has-workspaces: Text {
                text: "Notes";
                font-size: 22px;
                font-weight: 700;
                vertical-alignment: center;
                color: Palette.foreground;
                horizontal-stretch: 1;
            }
            // "● Diari ⌄": tap to switch workspace.
            if root.has-workspaces: ws-button := Rectangle {
                horizontal-stretch: 1;
                border-radius: 6px;
                background: ws-ta.has-hover ? Palette.foreground.with-alpha(0.06) : transparent;
                accessible-role: button;
                accessible-label: "Workspace " + root.active-name;
                accessible-action-default => { ws-menu.show(); }
                HorizontalLayout {
                    spacing: 6px;
                    alignment: start;
                    padding-left: 2px;
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 10px;
                            height: 10px;
                            border-radius: 5px;
                            background: root.active-color;
                        }
                    }
                    // Short names show whole; long ones are cut, but not
                    // below a few letters.
                    ws-name-text := Text {
                        text: root.active-name;
                        font-size: 22px;
                        font-weight: 700;
                        vertical-alignment: center;
                        overflow: elide;
                        min-width: min(self.preferred-width, 110px);
                        color: Palette.foreground;
                    }
                    VerticalLayout {
                        alignment: center;
                        Path {
                            width: 10px;
                            height: 6px;
                            commands: "M 0 0 L 10 0 L 5 6 Z";
                            fill: Palette.foreground.with-alpha(0.6);
                        }
                    }
                }
                ws-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { ws-menu.show(); }
                }
            }
            VerticalLayout {
                alignment: center;
                StatusChip {
                    state: root.status-state;
                    text: root.status-text;
                    clicked => { root.sync-now(); }
                }
            }
            Button {
                text: "Today";
                primary: true;
                clicked => { root.today(); }
            }
            RecordButton {
                clicked => { root.voice(); }
            }
            if root.can-photo: Button {
                icon: @image-url("../icons/camera-64.png");
                colorize-icon: true;
                accessible-label: "Photo";
                clicked => { root.photo(); }
            }
            Button {
                icon: @image-url("../icons/gear-64.png");
                colorize-icon: true;
                accessible-label: "Settings";
                clicked => { root.settings(); }
            }
        }
        if root.needs-migration: Rectangle {
            background: Palette.accent-background.with-alpha(0.12);
            border-radius: 6px;
            VerticalLayout {
                padding: 10px;
                spacing: 8px;
                Text {
                    text: "diari now has workspaces. Your notes will move into the diari/ folder (the journal), and other workspaces can hold notes on a subject.";
                    wrap: word-wrap;
                    color: Palette.foreground;
                    font-size: 13px;
                }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;
                    Button {
                        text: "Later";
                        clicked => { root.migrate-later(); }
                    }
                    Button {
                        text: "Move my notes";
                        primary: true;
                        clicked => { root.migrate(); }
                    }
                }
            }
        }
        if root.creating-workspace: HorizontalLayout {
            spacing: 8px;
            // Focus it once the menu that opened it has closed (closing
            // gives the focus back to what had it).
            Timer {
                interval: 100ms;
                triggered => {
                    ws-name.focus();
                    self.running = false;
                }
            }
            ws-name := LineEdit {
                placeholder-text: "New workspace name";
                accepted(t) => {
                    if t != "" {
                        root.creating-workspace = false;
                        root.new-workspace(t);
                    }
                }
            }
            Button {
                text: "Create";
                primary: true;
                enabled: ws-name.text != "";
                clicked => {
                    root.creating-workspace = false;
                    root.new-workspace(ws-name.text);
                }
            }
            Button {
                text: "Cancel";
                clicked => { root.creating-workspace = false; }
            }
        }
        if root.quick-visible: HorizontalLayout {
            spacing: 8px;
            LineEdit {
                placeholder-text: "Add a line to today…";
                text <=> root.quick-text;
                accepted => { root.do-quick-add(); }
                init => { self.focus(); }
            }
            Button {
                text: "Add";
                primary: true;
                enabled: root.quick-text != "";
                clicked => { root.do-quick-add(); }
            }
            Button {
                text: "Cancel";
                clicked => {
                    root.quick-text = "";
                    root.quick-visible = false;
                }
            }
        }
        LineEdit {
            placeholder-text: "Search names and text";
            text <=> root.filter;
            edited(t) => { root.filter-edited(t); }
        }
        HorizontalLayout {
            spacing: 8px;
            new-name := LineEdit {
                placeholder-text: "New note name";
                text: root.default-new-name;
                accepted => { root.do-create(); }
            }
            Button {
                text: "Create";
                primary: true;
                enabled: new-name.text != "";
                clicked => { root.do-create(); }
            }
        }
        ListView {
            vertical-stretch: 1;
            for n in root.notes: Rectangle {
                height: 54px;
                border-radius: 6px;
                background: n.path == root.current ? Palette.selection-background.with-alpha(0.35)
                    : ta.has-hover ? Palette.foreground.with-alpha(0.06) : transparent;
                ta := TouchArea {
                    clicked => { root.open(n.path); }
                }
                VerticalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    alignment: center;
                    spacing: 2px;
                    Text {
                        text: n.title;
                        font-size: 15px;
                        color: Palette.foreground;
                        overflow: elide;
                    }
                    Text {
                        text: n.subtitle;
                        font-size: 11px;
                        color: Palette.foreground.with-alpha(0.55);
                        overflow: elide;
                    }
                }
            }
        }
    }

    // The workspace menu, under the header.
    ws-menu := PopupWindow {
        x: 12px;
        y: 12px + header.height + 4px;
        width: min(root.width - 24px, 300px);
        Rectangle {
            background: Palette.alternate-background;
            border-color: Palette.border;
            border-width: 1px;
            border-radius: 6px;
            VerticalLayout {
                padding: 6px;
                for w in root.workspaces: WorkspaceRow {
                    label: w.name;
                    dot: w.color;
                    selected: w.folder == root.active-workspace;
                    clicked => { root.select-workspace(w.folder); }
                }
                WorkspaceRow {
                    label: "All workspaces";
                    dot: transparent;
                    selected: root.active-workspace == "";
                    clicked => { root.select-workspace(""); }
                }
                Rectangle {
                    height: 1px;
                    background: Palette.border;
                }
                WorkspaceRow {
                    label: "New workspace…";
                    dot: transparent;
                    clicked => { root.creating-workspace = true; }
                }
            }
        }
    }
}

component PreviewView inherits Rectangle {
    in property <[MdBlock]> blocks;
    callback open-link(string);
    callback toggle-task(int);
    ListView {
        for b in root.blocks: HorizontalLayout {
            padding-left: 12px + b.indent * 20px;
            padding-right: 12px;
            padding-top: b.kind >= 1 && b.kind <= 6 ? 12px : 4px;
            padding-bottom: 4px;
            spacing: 10px;
            if b.kind == 8: Rectangle {
                width: 3px;
                background: Palette.accent-background;
            }
            if b.kind == 10: VerticalLayout {
                alignment: center;
                padding-top: 6px;
                padding-bottom: 6px;
                Rectangle {
                    height: 1px;
                    background: Palette.foreground.with-alpha(0.25);
                }
            }
            if b.kind == 11: Rectangle {
                height: min(420px, (root.width - 24px - b.indent * 20px) * b.image.height / max(1, b.image.width));
                Image {
                    width: parent.width;
                    height: parent.height;
                    source: b.image;
                    image-fit: contain;
                    horizontal-alignment: left;
                }
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.open-link(b.target); }
                }
            }
            if b.kind == 12: Rectangle {
                height: link-text.preferred-height + 8px;
                border-radius: 4px;
                background: link-ta.has-hover ? Palette.accent-background.with-alpha(0.12) : transparent;
                link-text := Text {
                    x: 4px;
                    width: parent.width - 8px;
                    text: "→ " + b.text;
                    wrap: word-wrap;
                    color: Palette.accent-background;
                    font-size: 15px;
                }
                link-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.open-link(b.target); }
                }
            }
            if b.kind == 13: HorizontalLayout {
                spacing: 4px;
                VerticalLayout {
                    alignment: start;
                    CheckBox {
                        checked: b.checked;
                        accessible-label: b.text;
                        toggled => { root.toggle-task(b.pos); }
                    }
                }
                Text {
                    text: b.text;
                    wrap: word-wrap;
                    vertical-alignment: center;
                    color: b.checked ? Palette.foreground.with-alpha(0.5) : Palette.foreground;
                    font-size: 15px;
                    horizontal-stretch: 1;
                }
            }
            if b.kind != 10 && b.kind < 11: Rectangle {
                background: b.kind == 7 ? Palette.alternate-background : transparent;
                border-radius: 4px;
                HorizontalLayout {
                    padding: b.kind == 7 ? 8px : 0px;
                    Text {
                        text: b.text;
                        wrap: word-wrap;
                        color: b.kind == 8 ? Palette.foreground.with-alpha(0.75) : Palette.foreground;
                        font-size: b.kind == 1 ? 28px : b.kind == 2 ? 23px : b.kind == 3 ? 19px : b.kind >= 4 && b.kind <= 6 ? 16px : b.kind == 7 ? 13px : 15px;
                        font-weight: b.kind >= 1 && b.kind <= 6 ? 700 : 400;
                        font-family: b.kind == 7 ? "monospace" : "";
                        font-italic: b.kind == 8;
                    }
                }
            }
        }
    }
}

component VersionList inherits ListView {
    in property <[VersionItem]> versions;
    in property <string> selected;
    callback select(string);

    for v in root.versions: Rectangle {
        height: 50px;
        border-radius: 6px;
        background: v.id == root.selected ? Palette.selection-background.with-alpha(0.35)
            : vta.has-hover ? Palette.foreground.with-alpha(0.06) : transparent;
        vta := TouchArea {
            clicked => { root.select(v.id); }
        }
        VerticalLayout {
            padding-left: 10px;
            padding-right: 10px;
            alignment: center;
            Text {
                text: v.title;
                font-size: 13px;
                font-weight: 600;
                color: Palette.foreground;
                overflow: elide;
            }
            Text {
                text: v.subtitle;
                font-size: 11px;
                color: Palette.foreground.with-alpha(0.6);
                overflow: elide;
            }
        }
    }
}

component DiffView inherits Rectangle {
    in property <[DiffRow]> rows;
    background: Palette.background;
    border-radius: 4px;
    border-width: 1px;
    border-color: Palette.foreground.with-alpha(0.12);
    if root.rows.length == 0: Text {
        text: "No changes to this note in this version";
        color: Palette.foreground.with-alpha(0.5);
    }
    ListView {
        for r in root.rows: Rectangle {
            background: r.kind == 1 ? #22a55b30 : r.kind == 2 ? #d6454530 : transparent;
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                padding-top: r.kind == 3 ? 4px : 1px;
                padding-bottom: r.kind == 3 ? 4px : 1px;
                spacing: 8px;
                Text {
                    width: 12px;
                    text: r.kind == 1 ? "+" : r.kind == 2 ? "−" : r.kind == 3 ? "⋯" : "";
                    color: r.kind == 1 ? #22a55b : r.kind == 2 ? #d64545 : Palette.foreground.with-alpha(0.4);
                    font-family: EditorFont.family;
                    font-size: EditorFont.size;
                }
                Text {
                    horizontal-stretch: 1;
                    text: r.text;
                    wrap: word-wrap;
                    color: r.kind == 0 ? Palette.foreground.with-alpha(0.6) : Palette.foreground;
                    font-family: EditorFont.family;
                    font-size: EditorFont.size;
                }
            }
        }
    }
}

component VersionText inherits TextEdit {
    read-only: true;
    wrap: word-wrap;
    font-family: EditorFont.family;
    font-size: EditorFont.size;
}

component FilesPane inherits VerticalLayout {
    in property <[FileItem]> files;
    callback open(string);
    callback delete(string);
    callback close();
    // The file whose Delete was tapped once (tap again to confirm).
    property <string> confirm-delete;

    spacing: 8px;
    HorizontalLayout {
        spacing: 8px;
        Text {
            text: "Files (\{root.files.length})";
            font-size: 14px;
            font-weight: 600;
            vertical-alignment: center;
            color: Palette.foreground;
            horizontal-stretch: 1;
        }
        Button {
            text: "Close";
            clicked => { root.close(); }
        }
    }
    if root.files.length == 0: Text {
        text: "No files attached to this note yet. Share files to diari on Android, or drop them on the window on desktop.";
        wrap: word-wrap;
        color: Palette.foreground.with-alpha(0.6);
    }
    ListView {
        vertical-stretch: 1;
        for f in root.files: HorizontalLayout {
            padding-top: 4px;
            padding-bottom: 4px;
            spacing: 10px;
            Rectangle {
                width: 52px;
                height: 52px;
                border-radius: 4px;
                clip: true;
                background: Palette.alternate-background;
                if f.is-image: Image {
                    width: parent.width;
                    height: parent.height;
                    source: f.image;
                    image-fit: cover;
                }
                if !f.is-image: Text {
                    text: f.ext;
                    font-size: 12px;
                    font-weight: 600;
                    color: Palette.foreground.with-alpha(0.7);
                }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                Text {
                    text: f.name;
                    overflow: elide;
                    color: Palette.foreground;
                    font-size: 14px;
                }
                Text {
                    text: f.size;
                    color: Palette.foreground.with-alpha(0.6);
                    font-size: 12px;
                }
            }
            VerticalLayout {
                alignment: center;
                Button {
                    text: "Open";
                    clicked => { root.open(f.name); }
                }
            }
            VerticalLayout {
                alignment: center;
                Button {
                    text: root.confirm-delete == f.name ? "Really?" : "Delete";
                    clicked => {
                        if root.confirm-delete == f.name {
                            root.confirm-delete = "";
                            root.delete(f.name);
                        } else {
                            root.confirm-delete = f.name;
                        }
                    }
                }
            }
        }
    }
}

component CheckPane inherits VerticalLayout {
    in property <string> text;
    callback close();

    spacing: 8px;
    HorizontalLayout {
        spacing: 8px;
        Text {
            text: "Check config";
            font-size: 14px;
            font-weight: 600;
            vertical-alignment: center;
            color: Palette.foreground;
            horizontal-stretch: 1;
        }
        Button {
            text: "Close";
            clicked => { root.close(); }
        }
    }
    TextEdit {
        vertical-stretch: 1;
        read-only: true;
        wrap: word-wrap;
        text: root.text;
        font-family: EditorFont.family;
        font-size: EditorFont.size;
    }
}

component HistoryPane inherits VerticalLayout {
    in property <[VersionItem]> versions;
    in property <string> selected;
    in property <string> text;
    in property <[DiffRow]> diff;
    in-out property <bool> show-changes: true;
    callback select(string);
    callback restore();
    callback close();

    in property <bool> side-by-side;

    spacing: 8px;
    HorizontalLayout {
        spacing: 8px;
        Text {
            text: "History (\{root.versions.length})";
            font-size: 14px;
            font-weight: 600;
            vertical-alignment: center;
            color: Palette.foreground;
            horizontal-stretch: 1;
        }
        Button {
            text: root.show-changes ? "Full text" : "Changes";
            clicked => { root.show-changes = !root.show-changes; }
        }
        Button {
            text: "Restore";
            primary: true;
            enabled: root.selected != "";
            clicked => { root.restore(); }
        }
        Button {
            text: "Close";
            clicked => { root.close(); }
        }
    }
    if root.side-by-side: HorizontalLayout {
        vertical-stretch: 1;
        spacing: 8px;
        VersionList {
            width: 260px;
            versions: root.versions;
            selected: root.selected;
            select(id) => { root.select(id); }
        }
        if !root.show-changes: VersionText {
            horizontal-stretch: 1;
            text: root.text;
        }
        if root.show-changes: DiffView {
            horizontal-stretch: 1;
            rows: root.diff;
        }
    }
    if !root.side-by-side: VerticalLayout {
        vertical-stretch: 1;
        spacing: 8px;
        VersionList {
            height: 180px;
            versions: root.versions;
            selected: root.selected;
            select(id) => { root.select(id); }
        }
        if !root.show-changes: VersionText {
            vertical-stretch: 1;
            text: root.text;
        }
        if root.show-changes: DiffView {
            vertical-stretch: 1;
            rows: root.diff;
        }
    }
}

// The note's text editor. Like the standard TextEdit (whose background
// can't be changed), but on paper-coloured background in the light theme.
component NoteEditor inherits Rectangle {
    in-out property <string> text <=> input.text;
    callback edited(string);
    // After each change: the text, the cursor (byte offset) and the word
    // the keyboard is still composing (not in the text yet).
    callback typed(string, int, string);
    // Bump `cursor-request` to put the cursor at `cursor-request-pos`.
    in property <int> cursor-request;
    in property <int> cursor-request-pos;
    property <string> preedit: input.preedit-text;
    changed preedit => { root.typed(input.text, input.cursor-position-byte-offset, input.preedit-text); }
    changed cursor-request => {
        input.set-selection-offsets(root.cursor-request-pos, root.cursor-request-pos);
        input.focus();
    }
    forward-focus: input;

    background: Palette.color-scheme == ColorScheme.dark ? #ffffff0f : #FCF6E5;
    border-radius: 4px;
    border-width: 1px;
    border-color: input.has-focus ? Palette.accent-background : Palette.border;
    accessible-role: text-input;
    accessible-value: root.text;

    ContextMenuArea {
        Menu {
            MenuItem {
                title: "Undo";
                activated => { input.undo(); }
            }
            MenuItem {
                title: "Redo";
                activated => { input.redo(); }
            }
            MenuSeparator { }
            MenuItem {
                title: "Cut";
                enabled: input.has-selection;
                activated => { input.cut(); }
            }
            MenuItem {
                title: "Copy";
                enabled: input.has-selection;
                activated => { input.copy(); }
            }
            MenuItem {
                title: "Paste";
                activated => { input.paste(); }
            }
            MenuItem {
                title: "Select All";
                activated => { input.select-all(); }
            }
        }

        scroll := ScrollView {
            x: 12px;
            y: 12px;
            width: parent.width - 24px;
            height: parent.height - 24px;
            content-width: self.visible-width;
            content-height: max(self.visible-height, input.preferred-height);

            input := TextInput {
                single-line: false;
                wrap: word-wrap;
                font-family: EditorFont.family;
                font-size: EditorFont.size;
                color: Palette.foreground;
                selection-background-color: Palette.selection-background;
                selection-foreground-color: Palette.selection-foreground;
                page-height: scroll.visible-height;
                accessible-role: none;
                edited => {
                    root.edited(self.text);
                    root.typed(self.text, self.cursor-position-byte-offset, self.preedit-text);
                }
                // Keep the cursor in view (as the standard TextEdit does).
                cursor-position-changed(cpos) => {
                    if (cpos.y + scroll.content-y < 0px) {
                        scroll.content-y = min(0px, max(scroll.visible-height - self.height, -cpos.y));
                    } else if (cpos.y + scroll.content-y > scroll.visible-height - EditorFont.size * 1.6) {
                        scroll.content-y = min(0px, max(scroll.visible-height - self.height, scroll.visible-height - cpos.y - EditorFont.size * 1.6));
                    }
                }
            }
        }
    }
}

// A small tappable label. Unlike a Button it doesn't take the focus, so the
// editor (and the phone's keyboard) stay as they are.
component Chip inherits Rectangle {
    in property <string> text;
    callback clicked();
    height: 30px;
    min-width: label.preferred-width + 20px;
    max-width: 240px;
    border-radius: 15px;
    background: ta.pressed ? Palette.accent-background.with-alpha(0.3) : Palette.accent-background.with-alpha(0.14);
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { root.clicked(); }
    label := Text {
        x: 10px;
        width: parent.width - 20px;
        text: root.text;
        overflow: elide;
        vertical-alignment: center;
        color: Palette.foreground;
        font-size: 13px;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Chips in a row that scrolls sideways when they don't fit.
component ChipRow inherits Flickable {
    in property <string> title;
    in property <[string]> items;
    callback picked(string);
    height: 30px;
    content-width: max(self.width, row.preferred-width);
    interactive: true;
    row := HorizontalLayout {
        spacing: 6px;
        alignment: start;
        if root.title != "": Text {
            text: root.title;
            vertical-alignment: center;
            color: Palette.foreground.with-alpha(0.6);
            font-size: 13px;
        }
        for item in root.items: Chip {
            text: item;
            clicked => { root.picked(item); }
        }
    }
}

component EditorPane inherits Rectangle {
    in property <string> path;
    in property <bool> dirty;
    in property <bool> show-back;
    in property <[MdBlock]> blocks;
    in-out property <bool> preview;
    in-out property <string> text;
    in property <bool> show-history;
    in property <bool> show-files;
    in property <[FileItem]> files;
    callback open-files();
    callback close-files();
    callback open-file(string);
    callback delete-file(string);
    // CONFIG.md is open: the menu offers "Check config".
    in property <bool> is-config;
    in property <bool> show-check;
    in property <string> check-text;
    callback check-config();
    callback close-check();
    callback voice();
    callback photo();
    in property <bool> can-photo;
    // Links: notes to offer while typing `[[…`, notes linking to this one.
    in property <[string]> link-suggestions;
    in property <[string]> backlinks;
    callback link-typed(string, int, string);
    callback pick-link(string);
    in property <int> cursor-request;
    in property <int> cursor-request-pos;
    // A pane (history, files, check) is shown instead of the note.
    property <bool> pane-open: root.show-history || root.show-files || root.show-check;
    in property <[VersionItem]> versions;
    in property <string> history-selected;
    in property <string> history-text;
    in property <[DiffRow]> history-diff;
    in property <bool> history-side-by-side;
    callback edited(string);
    callback toggle-preview();
    callback open-link(string);
    callback toggle-task(int);
    callback open-history();
    callback select-version(string);
    callback restore-version();
    callback close-history();
    callback back();
    callback delete();
    callback rename(string);
    // Advanced mode (Settings) adds Delete to the menu.
    in property <bool> advanced;
    property <bool> confirm-delete: false;
    // Renaming or confirming a delete: the header shows only that.
    property <bool> header-busy: root.renaming || root.confirm-delete;
    property <bool> renaming: false;

    changed path => {
        root.confirm-delete = false;
        root.renaming = false;
    }

    background: Palette.background;
    VerticalLayout {
        padding: 12px;
        spacing: 8px;
        header := HorizontalLayout {
            spacing: 8px;
            if root.show-back && !root.header-busy: Button {
                text: "‹";
                clicked => { root.back(); }
            }
            // The note's name; the pencil turns it into a field to rename it.
            if !root.header-busy: Text {
                text: root.path;
                horizontal-stretch: 1;
                min-width: 40px;
                vertical-alignment: center;
                overflow: elide;
                font-size: 15px;
                font-weight: 600;
                color: Palette.foreground;
            }
            if root.renaming: LineEdit {
                text: root.path;
                horizontal-stretch: 1;
                min-width: 40px;
                init => {
                    self.focus();
                    self.select-all();
                }
                accepted(t) => {
                    root.renaming = false;
                    if t != root.path {
                        root.rename(t);
                    }
                }
            }
            if root.renaming: Button {
                text: "Cancel";
                clicked => { root.renaming = false; }
            }
            if root.confirm-delete: Text {
                text: "Delete \{root.path}?";
                horizontal-stretch: 1;
                min-width: 40px;
                vertical-alignment: center;
                overflow: elide;
                font-size: 15px;
                font-weight: 600;
                color: Palette.foreground;
            }
            if root.confirm-delete: Button {
                text: "Yes, delete";
                clicked => {
                    root.confirm-delete = false;
                    root.delete();
                }
            }
            if root.confirm-delete: Button {
                text: "Cancel";
                clicked => { root.confirm-delete = false; }
            }
            if !root.header-busy: VerticalLayout {
                alignment: center;
                Text {
                    text: root.dirty ? "●" : " ";
                    color: Palette.accent-background;
                    width: 12px;
                }
            }
            if !root.header-busy: Button {
                text: root.preview ? "Edit" : "Preview";
                enabled: !root.pane-open;
                clicked => { root.toggle-preview(); }
            }
            // Less-used actions live behind a menu button.
            if !root.header-busy: Button {
                icon: @image-url("../icons/menu-64.png");
                colorize-icon: true;
                icon-size: 18px;
                accessible-label: "Menu";
                clicked => { menu.show(); }
            }
        }
        if root.show-check: CheckPane {
            vertical-stretch: 1;
            text: root.check-text;
            close => { root.close-check(); }
        }
        if root.show-files: FilesPane {
            vertical-stretch: 1;
            files: root.files;
            open(n) => { root.open-file(n); }
            delete(n) => { root.delete-file(n); }
            close => { root.close-files(); }
        }
        if root.show-history: HistoryPane {
            vertical-stretch: 1;
            versions: root.versions;
            selected: root.history-selected;
            text: root.history-text;
            diff: root.history-diff;
            side-by-side: root.history-side-by-side;
            select(id) => { root.select-version(id); }
            restore => { root.restore-version(); }
            close => { root.close-history(); }
        }
        if !root.pane-open && !root.preview && root.link-suggestions.length > 0: ChipRow {
            items: root.link-suggestions;
            picked(n) => { root.pick-link(n); }
        }
        if !root.pane-open && !root.preview: NoteEditor {
            vertical-stretch: 1;
            text <=> root.text;
            cursor-request: root.cursor-request;
            cursor-request-pos: root.cursor-request-pos;
            edited(t) => { root.edited(t); }
            typed(t, c, p) => { root.link-typed(t, c, p); }
        }
        if !root.pane-open && !root.preview && root.backlinks.length > 0: ChipRow {
            title: "Linked from:";
            items: root.backlinks;
            picked(n) => { root.open-link("[[" + n + "]]"); }
        }
        if !root.pane-open && root.preview: PreviewView {
            vertical-stretch: 1;
            blocks: root.blocks;
            open-link(t) => { root.open-link(t); }
            toggle-task(p) => { root.toggle-task(p); }
        }
    }

    menu := PopupWindow {
        x: header.x + header.width - self.width;
        y: header.y + header.height + 4px;
        width: 160px;
        Rectangle {
            background: Palette.alternate-background;
            border-color: Palette.border;
            border-width: 1px;
            border-radius: 6px;
            VerticalLayout {
                padding: 6px;
                spacing: 4px;
                Button {
                    text: "Rename";
                    enabled: !root.show-history;
                    clicked => { root.renaming = true; }
                }
                Button {
                    text: "Voice note";
                    icon: @image-url("../icons/mic-64.png");
                    colorize-icon: true;
                    icon-size: 16px;
                    clicked => { root.voice(); }
                }
                if root.can-photo: Button {
                    text: "Photo";
                    icon: @image-url("../icons/camera-64.png");
                    colorize-icon: true;
                    icon-size: 16px;
                    clicked => { root.photo(); }
                }
                Button {
                    text: "History";
                    enabled: !root.pane-open;
                    clicked => { root.open-history(); }
                }
                Button {
                    text: "Files";
                    icon: @image-url("../icons/clip-64.png");
                    colorize-icon: true;
                    icon-size: 16px;
                    enabled: !root.pane-open;
                    clicked => { root.open-files(); }
                }
                if root.is-config: Button {
                    text: "Check config";
                    enabled: !root.pane-open;
                    clicked => { root.check-config(); }
                }
                // Advanced mode only. Asks to confirm in the header.
                if root.advanced: Button {
                    text: "Delete";
                    clicked => {
                        root.renaming = false;
                        root.confirm-delete = true;
                    }
                }
            }
        }
    }
}

component Field inherits VerticalLayout {
    in property <string> label;
    in property <string> placeholder;
    in-out property <string> value;
    spacing: 4px;
    Text {
        text: root.label;
        font-size: 12px;
        color: Palette.foreground.with-alpha(0.7);
    }
    LineEdit {
        text <=> root.value;
        placeholder-text: root.placeholder;
    }
}

component SettingsPane inherits Rectangle {
    in-out property <string> remote;
    in-out property <string> branch;
    in-out property <string> author-name;
    in-out property <string> author-email;
    in-out property <string> device;
    in-out property <string> notes-dir;
    in-out property <string> editor-font;
    in-out property <string> editor-font-size;
    in-out property <string> voice-language;
    // 0 auto, 1 light, 2 dark
    in-out property <int> theme;
    in property <string> default-font;
    in-out property <bool> advanced;
    in property <bool> show-notes-dir;
    in property <string> public-key;
    in property <string> key-fingerprint;
    callback save();
    callback close();
    callback regenerate-key();
    property <bool> copied: false;

    background: Palette.background;
    ScrollView {
        VerticalLayout {
            padding: 16px;
            spacing: 12px;
            alignment: start;
            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: "Settings";
                    font-size: 22px;
                    font-weight: 700;
                    color: Palette.foreground;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                }
                Button {
                    text: "Cancel";
                    clicked => { root.close(); }
                }
                Button {
                    text: "Save & sync";
                    primary: true;
                    clicked => { root.save(); }
                }
            }
            Field {
                label: "Git remote (SSH)";
                placeholder: "git@github.com:you/notes.git";
                value <=> root.remote;
            }
            Field {
                label: "Branch";
                placeholder: "main";
                value <=> root.branch;
            }
            Field {
                label: "Author name";
                value <=> root.author-name;
            }
            Field {
                label: "Author email";
                value <=> root.author-email;
            }
            Field {
                label: "Device name (used in commits and conflict files)";
                value <=> root.device;
            }
            if root.show-notes-dir: Field {
                label: "Notes folder (applies after restart)";
                value <=> root.notes-dir;
            }
            HorizontalLayout {
                spacing: 8px;
                Field {
                    horizontal-stretch: 3;
                    label: "Editor font (empty: \{root.default-font})";
                    placeholder: root.default-font;
                    value <=> root.editor-font;
                }
                Field {
                    horizontal-stretch: 1;
                    label: "Size";
                    placeholder: "14";
                    value <=> root.editor-font-size;
                }
            }
            VerticalLayout {
                spacing: 4px;
                Text {
                    text: "Theme";
                    font-size: 12px;
                    color: Palette.foreground.with-alpha(0.7);
                }
                ComboBox {
                    model: ["Auto (follow the system)", "Light", "Dark"];
                    current-index <=> root.theme;
                }
            }
            Field {
                label: "Voice note language (ca, es, en… or auto)";
                placeholder: "ca";
                value <=> root.voice-language;
            }
            Switch {
                text: "Advanced mode";
                checked <=> root.advanced;
            }
            Text {
                text: "Adds Delete to the note menu and shows the CONFIG file in the list.";
                font-size: 12px;
                wrap: word-wrap;
                color: Palette.foreground.with-alpha(0.7);
            }
            Text {
                text: "SSH public key: add it to your git host as a deploy key with write access";
                font-size: 12px;
                wrap: word-wrap;
                color: Palette.foreground.with-alpha(0.7);
            }
            key-view := TextEdit {
                text: root.public-key;
                read-only: true;
                wrap: word-wrap;
                font-family: EditorFont.family;
                font-size: 12px;
                height: 90px;
            }
            Text {
                text: root.key-fingerprint;
                font-size: 11px;
                font-family: EditorFont.family;
                color: Palette.foreground.with-alpha(0.6);
                wrap: word-wrap;
            }
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                Button {
                    text: root.copied ? "Copied" : "Copy key";
                    clicked => {
                        key-view.select-all();
                        key-view.copy();
                        key-view.clear-selection();
                        root.copied = true;
                    }
                }
                Button {
                    text: "Generate new key";
                    clicked => {
                        root.copied = false;
                        root.regenerate-key();
                    }
                }
            }
        }
    }
}

export component AppWindow inherits Window {
    icon: @image-url("../icons/diari-256.png");
    title: "diari";
    preferred-width: 1000px;
    preferred-height: 700px;
    min-width: 320px;
    min-height: 420px;
    background: Palette.background;

    in property <[NoteItem]> notes;
    in property <bool> has-workspaces;
    in property <[WorkspaceItem]> workspaces;
    in property <string> active-workspace;
    in property <string> active-name;
    in property <color> active-color;
    callback select-workspace(string);
    callback new-workspace(string);
    in property <bool> needs-migration;
    callback migrate();
    callback migrate-later();
    in-out property <string> filter;
    in property <string> default-new-name;
    in-out property <string> current-path;
    in-out property <string> editor-text;
    in-out property <bool> dirty;
    in-out property <bool> preview;
    in property <[MdBlock]> blocks;
    in-out property <bool> show-history;
    in property <[VersionItem]> versions;
    in property <string> history-selected;
    in property <string> history-text;
    in property <[DiffRow]> history-diff;
    in-out property <bool> show-files;
    in property <[FileItem]> files;
    callback open-files();
    callback close-files();
    callback open-file(string);
    callback delete-file(string);
    in property <bool> current-is-config;
    in-out property <bool> show-check;
    in property <string> check-text;
    callback check-config();
    callback close-check();
    // Voice notes: 0 idle, 1 asking to download the model, 2 recording,
    // 3 working (downloading or transcribing).
    in property <int> voice-state;
    in property <string> voice-text;
    // into-note: add the text to the open note (else to today's).
    callback voice-record(bool);
    // Take a picture with the camera app (Android); into-note as above.
    callback take-photo(bool);
    // Android back gesture / Escape, given whether the layout is wide;
    // false when there's nothing to go back to.
    callback back-pressed(bool) -> bool;
    callback voice-stop();
    callback voice-cancel();
    callback voice-download();
    in-out property <string> quick-text;
    in-out property <bool> quick-visible;
    callback quick-add(string);
    in property <string> sync-text: "Starting…";
    in property <int> sync-state: 1;
    in property <string> message;
    in property <bool> desktop;
    in-out property <bool> show-settings;

    in-out property <string> cfg-remote;
    in-out property <string> cfg-branch;
    in-out property <string> cfg-author-name;
    in-out property <string> cfg-author-email;
    in-out property <string> cfg-device;
    in-out property <string> cfg-notes-dir;
    in-out property <string> cfg-editor-font;
    in-out property <string> cfg-editor-font-size;
    in-out property <string> cfg-voice-language;
    in-out property <int> cfg-theme;
    // The theme in use (0 auto, 1 light, 2 dark), applied to all widgets.
    in property <int> theme;
    changed theme => {
        Palette.color-scheme = root.theme == 1 ? ColorScheme.light : root.theme == 2 ? ColorScheme.dark : ColorScheme.unknown;
    }
    in property <string> default-font;
    in-out property <bool> cfg-advanced;
    in property <bool> advanced;
    in property <string> public-key;
    in property <string> key-fingerprint;

    callback open-note(string);
    callback new-note(string);
    callback open-today();
    callback rename-note(string);
    callback delete-note();
    callback text-edited(string);
    in property <[string]> link-suggestions;
    in property <[string]> backlinks;
    callback link-typed(string, int, string);
    callback pick-link(string);
    in property <int> cursor-request;
    in property <int> cursor-request-pos;
    callback preview-toggled();
    callback open-link(string);
    callback toggle-task(int);
    callback open-history();
    callback select-version(string);
    callback restore-version();
    callback close-history();
    callback sync-now();
    callback open-settings();
    callback save-settings();
    callback regenerate-key();
    callback filter-edited(string);
    callback back();

    // Room taken by the system bars (Android 15+ draws apps edge to edge) and,
    // when it's up, by the on-screen keyboard, which no longer shrinks the window.
    property <length> keyboard-top: root.virtual-keyboard-size.height > 0 ? root.virtual-keyboard-position.y : root.height;
    property <length> inset-top: root.safe-area-insets.top;
    property <length> inset-bottom: max(root.safe-area-insets.bottom, root.height - root.keyboard-top);
    property <length> inset-left: root.safe-area-insets.left;
    property <length> inset-right: root.safe-area-insets.right;
    property <length> content-width: root.width - root.inset-left - root.inset-right;
    property <bool> wide: root.content-width >= 720px;

    // Catches Android's back gesture (and Escape) when no field takes it.
    // It takes the focus back whenever the screen changes, since the key
    // only reaches it through the focused element.
    init => { keys.focus(); }
    changed current-path => { keys.focus(); }
    changed preview => { keys.focus(); }
    changed show-settings => { keys.focus(); }
    changed show-files => { keys.focus(); }
    changed show-history => { keys.focus(); }
    changed show-check => { keys.focus(); }
    keys := FocusScope {
        x: root.inset-left;
        y: root.inset-top;
        width: root.content-width;
        height: root.height - root.inset-top - root.inset-bottom;
        key-pressed(event) => {
            if (event.text == Key.Back || event.text == Key.Escape) && root.back-pressed(root.wide) {
                self.focus();
                return accept;
            }
            reject
        }
    VerticalLayout {
        width: parent.width;
        height: parent.height;
        if root.show-settings: SettingsPane {
            vertical-stretch: 1;
            remote <=> root.cfg-remote;
            branch <=> root.cfg-branch;
            author-name <=> root.cfg-author-name;
            author-email <=> root.cfg-author-email;
            device <=> root.cfg-device;
            notes-dir <=> root.cfg-notes-dir;
            editor-font <=> root.cfg-editor-font;
            editor-font-size <=> root.cfg-editor-font-size;
            voice-language <=> root.cfg-voice-language;
            theme <=> root.cfg-theme;
            default-font: root.default-font;
            advanced <=> root.cfg-advanced;
            show-notes-dir: root.desktop;
            public-key: root.public-key;
            key-fingerprint: root.key-fingerprint;
            save => { root.save-settings(); }
            close => { root.show-settings = false; }
            regenerate-key => { root.regenerate-key(); }
        }

        if !root.show-settings: HorizontalLayout {
            vertical-stretch: 1;
            if root.wide || root.current-path == "": ListPane {
                width: root.wide ? 340px : root.content-width;
                notes: root.notes;
                current: root.current-path;
                status-text: root.sync-text;
                status-state: root.sync-state;
                filter <=> root.filter;
                default-new-name: root.default-new-name;
                quick-text <=> root.quick-text;
                quick-visible <=> root.quick-visible;
                quick-add(t) => { root.quick-add(t); }
                open(p) => { root.open-note(p); }
                create(n) => { root.new-note(n); }
                today => { root.open-today(); }
                voice => { root.voice-record(false); }
                photo => { root.take-photo(false); }
                can-photo: !root.desktop;
                sync-now => { root.sync-now(); }
                settings => { root.open-settings(); }
                filter-edited(t) => { root.filter-edited(t); }
                has-workspaces: root.has-workspaces;
                workspaces: root.workspaces;
                active-workspace: root.active-workspace;
                active-name: root.active-name;
                active-color: root.active-color;
                select-workspace(f) => { root.select-workspace(f); }
                new-workspace(n) => { root.new-workspace(n); }
                needs-migration: root.needs-migration;
                migrate => { root.migrate(); }
                migrate-later => { root.migrate-later(); }
            }
            if root.wide: Rectangle {
                width: 1px;
                background: Palette.foreground.with-alpha(0.12);
            }
            if root.current-path != "": EditorPane {
                horizontal-stretch: 1;
                path: root.current-path;
                dirty: root.dirty;
                // Android has its back gesture; a narrow desktop window needs a button.
                show-back: !root.wide && root.desktop;
                blocks: root.blocks;
                preview <=> root.preview;
                text <=> root.editor-text;
                edited(t) => { root.text-edited(t); }
                link-suggestions: root.link-suggestions;
                backlinks: root.backlinks;
                link-typed(t, c, p) => { root.link-typed(t, c, p); }
                pick-link(n) => { root.pick-link(n); }
                cursor-request: root.cursor-request;
                cursor-request-pos: root.cursor-request-pos;
                toggle-preview => { root.preview-toggled(); }
                open-link(t) => { root.open-link(t); }
                toggle-task(p) => { root.toggle-task(p); }
                show-history: root.show-history;
                versions: root.versions;
                history-selected: root.history-selected;
                history-text: root.history-text;
                history-diff: root.history-diff;
                advanced: root.advanced;
                show-files: root.show-files;
                files: root.files;
                open-files => { root.open-files(); }
                close-files => { root.close-files(); }
                open-file(n) => { root.open-file(n); }
                delete-file(n) => { root.delete-file(n); }
                is-config: root.current-is-config;
                show-check: root.show-check;
                check-text: root.check-text;
                check-config => { root.check-config(); }
                close-check => { root.close-check(); }
                voice => { root.voice-record(true); }
                photo => { root.take-photo(true); }
                can-photo: !root.desktop;
                history-side-by-side: root.content-width >= 1000px;
                open-history => { root.open-history(); }
                select-version(id) => { root.select-version(id); }
                restore-version => { root.restore-version(); }
                close-history => { root.close-history(); }
                back => { root.back(); }
                delete => { root.delete-note(); }
                rename(n) => { root.rename-note(n); }
            }
            if root.wide && root.current-path == "": Rectangle {
                horizontal-stretch: 1;
                Text {
                    text: "Select or create a note";
                    color: Palette.foreground.with-alpha(0.5);
                    font-size: 16px;
                }
            }
        }

        if root.voice-state != 0: Rectangle {
            background: Palette.alternate-background;
            border-color: Palette.border;
            border-width: 1px;
            HorizontalLayout {
                padding: 10px;
                spacing: 8px;
                if root.voice-state == 2: VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 12px;
                        height: 12px;
                        border-radius: 6px;
                        background: #d64545;
                    }
                }
                Text {
                    text: root.voice-text;
                    wrap: word-wrap;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    color: Palette.foreground;
                    font-size: 14px;
                }
                if root.voice-state == 1: Button {
                    text: "Download";
                    primary: true;
                    clicked => { root.voice-download(); }
                }
                if root.voice-state == 2: Button {
                    text: "Stop";
                    primary: true;
                    clicked => { root.voice-stop(); }
                }
                if root.voice-state == 1 || root.voice-state == 2: Button {
                    text: "Cancel";
                    clicked => { root.voice-cancel(); }
                }
            }
        }
        if root.message != "": Rectangle {
            background: #d6454530;
            HorizontalLayout {
                padding: 8px;
                Text {
                    text: root.message;
                    wrap: word-wrap;
                    color: Palette.foreground;
                    font-size: 12px;
                }
            }
        }
    }
    }
}
